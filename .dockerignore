# Dependencies — installed fresh in the deps stage from package-lock.json.
node_modules

# Build output — regenerated by `npm run build` inside the image.
.next
out
build

# VCS
.git
.gitignore
.github

# Env files — secrets are injected at runtime/build via --build-arg / -e,
# never baked in from a local file.
.env
.env.*
!.env.example

# Local SQLite database. TRACKED IN GIT — must stay out of the image or a
# mis-configured deploy (unset TURSO_DATABASE_URL) silently runs against a
# stale committed database instead of failing loudly (lib/server/db.ts:3).
my-content.db

# Docs, tests, tooling — not needed at runtime.
docs
tests
.claude
README.md

# Misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vercel
*.tsbuildinfo
next-env.d.ts
coverage
